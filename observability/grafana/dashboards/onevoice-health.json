  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "title": "HTTP / LLM / Tool detail",
      "type": "dashboards",
      "tags": ["onevoice", "metrics"],
      "asDropdown": false,
      "includeVars": false,
      "keepTime": true,
      "targetBlank": false
