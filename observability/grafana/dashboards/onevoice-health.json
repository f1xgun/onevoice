    {
      "datasource": "Prometheus",
      "description": "HTTP request rate per service and status code.",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "palette-classic"},
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
