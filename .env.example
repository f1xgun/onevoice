# =====================================================================
# OneVoice — .env.example
# =====================================================================
# Copy to .env.prod on the VM (or .env locally) and fill in values.
# .env is gitignored. NEVER commit a real .env.
#
# Sections:
#   1. Deployment domain & TLS (Certbot)
#   2. CORS + public URLs
#   3. Secrets (JWT, encryption, MinIO root)
#   4. Datastores (PostgreSQL, MongoDB, Redis)
#   5. LLM providers (OpenRouter / OpenAI / Anthropic / self-hosted)
#   6. Object storage (S3 / MinIO)
#   7. OAuth — VK / Yandex / Google
#   8. Telegram bot
#   9. Review sync + AI review drafts
#  10. Frontend build-time vars
#  11. Optional knobs (timeouts, rate limits, log levels)
#
# Generation cheatsheet (run on the VM, once):
#   JWT_SECRET       — 32+ random chars   :  openssl rand -base64 48
#   ENCRYPTION_KEY   — EXACTLY 32 bytes   :  openssl rand -base64 24
#   MINIO_ROOT_*     — random alnum       :  openssl rand -base64 24
#   MONGO_ROOT_PASSWORD — URL-safe (hex)  :  openssl rand -hex 24
# =====================================================================


# ---------------------------------------------------------------------
# 1. Deployment domain & TLS (Certbot)
# ---------------------------------------------------------------------
# Used by nginx (server_name) and Certbot to provision certificates.
# Set BEFORE the first `docker compose up`, otherwise nginx will fail
# the SSL handshake and Certbot's ACME challenge will return 404.
DOMAIN=app.example.com

# Email used by Let's Encrypt for expiry notifications and account ID.
# Must be a real mailbox you read — Let's Encrypt sends renewal warnings.
ACME_EMAIL=ops@example.com

# Certbot staging flag. Set to 1 during initial setup to avoid the
# Let's Encrypt rate limit (5 failed registrations per hour). Flip to
# 0 once HTTP-01 challenges succeed, then re-run `docker compose run
# --rm certbot`.
CERTBOT_STAGING=0


# ---------------------------------------------------------------------
# 2. CORS + public URLs
# ---------------------------------------------------------------------
# Comma-separated list of origins allowed to hit the API, and the allow-list
# for the handler-level Origin (CSRF) check on the erasure / consent /
# organisation-lifecycle endpoints. In prod MUST be the public frontend origin
# (e.g. https://app.example.com). Never use `*` here — security.md forbids it.
# Leave unset to default to PUBLIC_URL (plus http://localhost:3000 outside
# production), so the origin a browser sends behind nginx always passes.
CORS_ALLOWED_ORIGINS=https://app.example.com

# Public URL of the API. Used for absolute links the API generates
# (OAuth callbacks, signed URLs, audit log targets). For a same-origin
# deploy behind nginx use https://${DOMAIN}.
PUBLIC_URL=https://app.example.com


# ---------------------------------------------------------------------
# 3. Secrets — REQUIRED, no safe defaults
# ---------------------------------------------------------------------
# API fails to boot if JWT_SECRET or ENCRYPTION_KEY are missing, the
# wrong length, OR if ENCRYPTION_KEY fails the SEC-11 strength gate
# (deny-list / repeat-pattern / Shannon entropy / zxcvbn dictionary).
# Do NOT reuse dev values — they are public.

# APP_ENV gates the production-only LEGAL_* checks (SEC-23). Distinct
# from ENV which controls pkg/logger labels. Strict separation: setting
# ENV=production is NOT enough — APP_ENV must also be set so that
# legal-disclosure validators run.
APP_ENV=development

# Minimum 32 chars. Generate: openssl rand -base64 48
JWT_SECRET=

# EXACTLY 32 bytes (AES-256). Generate: openssl rand -base64 24
# (base64 of 24 random bytes = 32 ASCII chars = 32 bytes when read as a
# string). Boot validation: deny-list + Shannon entropy >=3.5 bits/byte
# + zxcvbn score >=3. Sequential / repeated / dictionary keys are
# rejected at startup.
ENCRYPTION_KEY=

# MinIO root credentials. REQUIRED — docker-compose.yml has no default
# fallback, so an empty value aborts `docker compose up`. Used both by the
# MinIO server and by the S3 client in the API. Never use minioadmin/minioadmin.
# Generate: openssl rand -base64 24
MINIO_ROOT_USER=changeme-minio-user
MINIO_ROOT_PASSWORD=changeme-minio-password


# ---------------------------------------------------------------------
# 4. Datastores
# ---------------------------------------------------------------------
# Hostnames here resolve inside the docker-compose network. Override
# only if you bring your own managed DB.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# REQUIRED — docker-compose.yml has no default fallback, so an empty value
# aborts `docker compose up`. Never ship the literal "postgres" to a VM with
# any datastore port reachable. Generate: openssl rand -base64 24
POSTGRES_PASSWORD=changeme-postgres-password
POSTGRES_DB=onevoice

# PostgreSQL pgxpool sizing. Defaults sized for free-beta single-pod
# (~10-20 concurrent chats). Raise for paid tiers / larger deployments.
# All six knobs fail loud on invalid input — a typo aborts boot rather
# than silently using a default. PG_MIN_CONNS must be <= PG_MAX_CONNS;
# PG_MAX_CONNS must be > 0 and <= 2^31-1 (pgxpool int32 bound).
# PG_MAX_CONNS=25
# PG_MIN_CONNS=2
# PG_MAX_CONN_LIFETIME=30m
# PG_MAX_CONN_IDLE_TIME=15m
# PG_HEALTH_CHECK_PERIOD=1m
# PG_MAX_CONN_LIFETIME_JITTER=3m

# MongoDB runs with access control enabled — docker-compose.yml starts mongod
# with `--auth` and creates the root user on first boot from MONGO_ROOT_USERNAME
# / MONGO_ROOT_PASSWORD. REQUIRED for the compose stack: an empty value aborts
# `docker compose up`. Use a URL-safe password (hex) — it is embedded in the
# connection URI. NOTE: an existing pre-auth mongodb_data volume already has no
# root user, so `--auth` would lock everyone out; recreate the volume (dev) or
# create the root user via the localhost exception before upgrading.
#   MONGO_ROOT_USERNAME — any non-empty account name (e.g. onevoice)
#   MONGO_ROOT_PASSWORD — openssl rand -hex 24
MONGO_ROOT_USERNAME=onevoice
MONGO_ROOT_PASSWORD=changeme-mongo-password
# Under compose the api/orchestrator MONGO_URI is composed automatically from the
# credentials above (mongodb://<user>:<pass>@mongodb:27017/onevoice?authSource=admin).
# The value below is consulted only by host-run binaries dialing the loopback-
# mapped port; keep it in sync with the credentials above.
MONGO_URI=mongodb://onevoice:changeme-mongo-password@localhost:27017/onevoice?authSource=admin
MONGO_DB=onevoice

REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD authenticates Redis. docker-compose.yml starts Redis with
# `--requirepass ${REDIS_PASSWORD}` and every client (api via REDIS_PASSWORD,
# agents/orchestrator via the password embedded in REDIS_URL) must present it,
# so this is REQUIRED for the compose stack.  openssl rand -base64 24
REDIS_PASSWORD=

# NATS message bus — orchestrator → agent task dispatch.
NATS_URL=nats://nats:4222
# NATS auth is per-service nkey + mandatory TLS — there is NO shared password.
# Each service presents its own nkey seed; the server (infra/nats/nats-server.conf
# + the generated creds/auth.conf) maps its public key to a subject-scoped
# allow-list, and clients verify the server cert against the dev CA. Provision
# both before `docker compose up`:
#   make nats-creds   # nkey seeds + auth.conf → infra/nats/creds/ (gitignored)
#   make mtls-certs   # dev CA + nats server cert → infra/mtls/certs/ (gitignored)
# Compose mounts each service's seed and sets NATS_NKEY_SEED + NATS_CA_PATH
# itself, so no NATS auth vars belong in this file for the compose stack.
#
# Running a service binary on the HOST (outside compose) instead: point it at a
# seed and the CA yourself. pkg/natsauth reads (in precedence order) NATS_CREDS
# (a JWT+nkey creds file) > NATS_NKEY_SEED (an nkey seed file) > NATS_USER/
# NATS_PASSWORD, plus NATS_CA_PATH / NATS_CLIENT_CERT / NATS_CLIENT_KEY for TLS.
# NATS_NKEY_SEED=infra/nats/creds/orchestrator.nk
# NATS_CA_PATH=infra/mtls/certs/ca.crt
# NATS_CREDS=

# A2A_PAYLOAD_KEY — REQUIRED, EXACTLY 32 bytes (openssl rand -base64 24). Shared
# key that seals secret A2A tool arguments (the Yandex connect cookies) with
# AES-256-GCM before they cross the NATS bus, so the broker never sees the
# plaintext session cookie (defense-in-depth on top of the mandatory NATS TLS).
# Must be IDENTICAL on the api and agent-yandex-business services; both refuse to
# boot without it.
A2A_PAYLOAD_KEY=

# ORCHESTRATOR_INTERNAL_SECRET — 16+ random chars (openssl rand -base64 32).
# Shared secret authenticating api→orchestrator calls. The api stamps it on
# every request; the orchestrator rejects unauthenticated callers so its
# internal inbound (chat/resume/draft-reply) — which trusts request-body
# identity and tier — cannot be reached (or its tier forged to "enterprise",
# bypassing the LLM cost guards) by anyone routing to :8090. MUST be identical
# on the api and orchestrator services. Empty is refused at boot when
# APP_ENV=production; docker-compose requires it for both services.
ORCHESTRATOR_INTERNAL_SECRET=


# ---------------------------------------------------------------------
# 5. LLM providers
# ---------------------------------------------------------------------
# Orchestrator REQUIRES LLM_MODEL + at least one provider key.
# Format: `provider/model` (e.g. openai/gpt-4o-mini, anthropic/claude-3-5-sonnet).
#
# PRODUCTION (152-ФЗ data residency): prompts carry business and customer
# personal data, so with APP_ENV=production both api and orchestrator REFUSE
# TO BOOT when any hosted key (OPENROUTER/OPENAI/ANTHROPIC) is set or when a
# configured model is not served by a SELF_HOSTED_N_* endpoint — unless
# ALLOW_TRANSBORDER_LLM=true records a filed cross-border legal basis. The
# locked production setup is DeepSeek V4 Flash on Yandex AI Studio (RF):
#   SELF_HOSTED_0_URL=https://llm.api.cloud.yandex.net/v1
#   SELF_HOSTED_0_MODEL=gpt://<folder-id>/deepseek-v4-flash/latest
#   SELF_HOSTED_0_API_KEY=<service-account API key>
#   LLM_MODEL=gpt://<folder-id>/deepseek-v4-flash/latest   (TITLER/DRAFT too)
# with a second RF-hosted model in SELF_HOSTED_1_* as the fallback. Every
# self-hosted request carries x-data-logging-enabled:false so AI Studio does
# not retain prompt payloads. See docs/runbook-founder-manual-actions.md.
#
# DEV default is anthropic/claude-sonnet-4-6 for prompt-cache savings (~60%
# input cost reduction on turn 2+ when cache hits) and improved Russian
# quality. Requires ANTHROPIC_API_KEY set below (or OPENROUTER_API_KEY, which
# fronts Anthropic). scripts/check-llm-defaults.sh asserts this default in CI.
LLM_MODEL=anthropic/claude-sonnet-4-6

# Tier used by the rate limiter (free | paid). Affects per-user token budgets.
LLM_TIER=paid

# At least ONE of the three keys below MUST be set for the orchestrator
# to start. OpenRouter is the primary path (it fronts all providers
# with a single key); OPENAI/ANTHROPIC are direct fallbacks.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Self-hosted endpoints (optional). Indexed: SELF_HOSTED_0_URL,
# SELF_HOSTED_0_MODEL, SELF_HOSTED_0_API_KEY (then _1_, _2_, ...).
# Scanning stops at the first missing _URL. Entries with no _MODEL
# are skipped. API_KEY is optional per endpoint.
# SELF_HOSTED_0_URL=https://llm.internal/v1
# SELF_HOSTED_0_MODEL=llama-3.1-70b
# SELF_HOSTED_0_API_KEY=

# Auto-titler model (services/api). Default: claude-haiku-4-5 —
# Anthropic's cheap-tier model ($1/$5 per MTok). Falls back to LLM_MODEL
# when unset; the titler is disabled gracefully if no provider key is
# present for the chosen model.
TITLER_MODEL=anthropic/claude-haiku-4-5

# Draft-reply model (services/orchestrator). Used by the review_sync
# pipeline to draft AI-suggested replies to reviews. Same cheap-tier
# default as TITLER_MODEL; falls back to LLM_MODEL when unset. Split into
# its own env var (rather than reusing TITLER_MODEL) so titler and drafter
# can be tuned to different cheap models independently.
DRAFT_REPLY_MODEL=anthropic/claude-haiku-4-5


# ---------------------------------------------------------------------
# 6. Object storage (S3 / MinIO)
# ---------------------------------------------------------------------
S3_ENDPOINT=minio:9000
S3_BUCKET=onevoice
# Set to true ONLY if you front MinIO/S3 with HTTPS at the endpoint
# itself. The default deploy terminates TLS at nginx, leaves MinIO
# on plain HTTP inside the docker network.
S3_USE_SSL=false
# URL prefix the API stamps on every uploaded object's public URL.
# Nginx rewrites /media/<key> -> /<bucket>/<key> on MinIO.
S3_PUBLIC_URL_PREFIX=/media


# ---------------------------------------------------------------------
# 6a. Image generation (orchestrator generate_image tool) — OFF BY DEFAULT
# ---------------------------------------------------------------------
# The generate_image tool stays completely inert unless IMAGE_GEN_ENABLED
# is true AND the selected provider's credential plus an object store
# (S3_ENDPOINT + an absolute https PUBLIC_URL) are configured. Leave
# disabled unless you have deliberately turned the feature on.
IMAGE_GEN_ENABLED=false
# Provider: "openai" (DALL·E 3, uses OPENAI_API_KEY) or "yandexart" (Yandex
# Cloud AI Studio YandexART, uses YANDEX_ART_API_KEY + YANDEX_ART_FOLDER_ID
# below). IMAGE_GEN_MODEL is only consulted by the openai provider.
IMAGE_GEN_PROVIDER=openai
IMAGE_GEN_MODEL=dall-e-3
# Default image size when a request omits one (allowed: 1024x1024,
# 1792x1024, 1024x1792).
IMAGE_GEN_SIZE=1024x1024
# Max decoded image size in bytes (default 10 MiB) — a larger result is
# rejected before upload.
IMAGE_GEN_MAX_BYTES=10485760
# Max images a single chat turn may generate (default 2). Each generation
# is a paid provider call, so this bounds worst-case per-turn image spend.
# Set to 0 to disable the cap.
IMAGE_GEN_MAX_PER_TURN=2
# Bound on the boot-time bucket existence/creation call so an unreachable
# object store cannot stall orchestrator startup (default 10s). Only used
# when image generation is enabled.
IMAGE_GEN_BUCKET_TIMEOUT=10s
# YandexART (Yandex Cloud AI Studio) credentials — only used when
# IMAGE_GEN_PROVIDER=yandexart. Empty by default so image generation stays
# OFF until real keys are supplied. YANDEX_ART_API_KEY is a Yandex Cloud
# service-account "Api-Key"; YANDEX_ART_FOLDER_ID is the folder id used in
# the art:// model uri.
YANDEX_ART_API_KEY=
YANDEX_ART_FOLDER_ID=
# Object store credentials for the orchestrator-local media bucket (mirror
# the API's S3 keys so one bucket serves both). Required only when image
# generation is enabled.
S3_ACCESS_KEY=
S3_SECRET_KEY=


# ---------------------------------------------------------------------
# 7. OAuth — VK / Yandex / Google
# ---------------------------------------------------------------------
# All redirect URIs MUST match exactly what is registered in the
# provider's app dashboard. Wrong host/path → callback fails silently.

# VK ID app (user auth). Distinct from VK_SERVICE_KEY.
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://app.example.com/api/v1/oauth/vk/callback
# Service access token from the VK Mini-App. Used by wall.getComments /
# groups.getById. Without it the VK agent can't sync reviews.
VK_SERVICE_KEY=

# Yandex OAuth (used to issue the session bridge to Yandex.Business).
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://app.example.com/api/v1/oauth/yandex_business/callback

# Yandex.Business RPA browser pool cap. Each Playwright BrowserContext
# costs ~80-150 MB; 10 fits comfortably in ~1.5 GB of agent headroom.
# When the pool is at cap, a fresh-businessID acquire evicts the LRU
# non-busy context, or waits up to 30s for a slot to free. Set to 0 to
# disable the cap (dev/test only — production must keep > 0). Fail-loud
# on non-integer / negative input.
BROWSER_POOL_MAX_CONTEXTS=10

# RPA screenshot mode (services/agent-yandex-business). One of:
#   off    — no screenshots (production default; protects PII in DOM)
#   tmpfs  — /dev/shm/onevoice-rpa-screenshots/ with 1h TTL sweeper (staging)
#   full   — /tmp/yandex_<label>_<ts>.png with no TTL (dev)
# Unknown values fall back to off (defensive). If APP_ENV=production
# AND SCREENSHOT_MODE != off, the agent boots with a slog.Warn —
# operator may still need it during live incident response, but the
# loud signal prevents silent prod leaks. The previous boolean
# debug-screenshots env is gone; remove it from any existing .env.
SCREENSHOT_MODE=off

# Google OAuth. ONLY required if you flip on the (currently unverified)
# Google Business agent; otherwise leave blank — code is graceful.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://app.example.com/api/v1/oauth/google_business/callback


# ---------------------------------------------------------------------
# 8. Telegram bot
# ---------------------------------------------------------------------
# Token from @BotFather. Required for the Telegram agent.
TELEGRAM_BOT_TOKEN=


# ---------------------------------------------------------------------
# 9. Review sync + AI review drafts
# ---------------------------------------------------------------------
# Background sync interval (minutes). 0 disables. Default 30.
REVIEW_SYNC_INTERVAL_MINUTES=30

# AI draft generation runs after each successful sync pass. OFF by
# default — flipping to true starts LLM spend on every cycle. Keep
# false until you have provider budget alerts wired up.
REVIEW_DRAFT_ENABLED=false
REVIEW_DRAFT_MAX_EXAMPLES=5
REVIEW_DRAFT_BATCH_LIMIT=10

# Proactive platform-sync reconciler (drift detection). Ships DARK: the
# sync_state table + the GET .../integrations/drift and POST .../integrations/verify
# endpoints exist regardless, but the background reconcile loop only runs when
# this is explicitly true. Leaving it false is zero extra polling load.
SYNC_RECONCILE_ENABLED=false
# Poll granularity — how often the loop wakes to check for due channels. The
# per-channel re-check cadence (24h free / 6h paid; Yandex always 24h) is
# enforced per row, so this is NOT the re-check frequency. Default 30m.
SYNC_RECONCILE_POLL_INTERVAL=30m

# Monthly credit-grant worker. Lands each active business's plan allowance
# (plan_definitions.monthly_credits) into credit_ledger, idempotently per
# (business, YYYY-MM). Defaults ON: without a grant the ledger has no `grant`
# rows, so every business reads a 0 balance and the billing UI shows
# remaining=0. It is idempotent and changes no gating (nothing charges credits
# yet), so enabling it is a pure balance-visibility fix.
CREDIT_GRANT_ENABLED=true
# Poll granularity — how often the worker re-checks the fleet. The grant is
# idempotent per period (a cheap EXISTS pre-check per business), so this only
# bounds how quickly a new business or a new month's reset lands. Default 1h.
CREDIT_GRANT_POLL_INTERVAL=1h


# ---------------------------------------------------------------------
# 10. Frontend build-time vars
# ---------------------------------------------------------------------
# Inlined by Next.js at BUILD time (NEXT_PUBLIC_* prefix). Default
# "/api/v1" uses the same-origin rewrite proxy in next.config.js.
# Only change if the frontend is served from a different origin than
# the API (then CORS_ALLOWED_ORIGINS must include the frontend origin).
NEXT_PUBLIC_API_URL=/api/v1


# ---------------------------------------------------------------------
# 11. Optional knobs (uncomment to override)
# ---------------------------------------------------------------------
# --- HTTP server / orchestrator timeouts (Go duration syntax) ---
# HTTP_READ_TIMEOUT=15s
# HTTP_READ_HEADER_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
# ORCHESTRATOR_FETCH_TIMEOUT=10s
# SHUTDOWN_TIMEOUT=30s
# TOOL_EXEC_TIMEOUT=30s

# --- Per-endpoint per-minute rate limits ---
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_CHAT=10
# RATE_LIMIT_HITL=10
# RATE_LIMIT_CONSENTS=10  # per-user /min for /auth/consents and /users/me/consents/pdn/withdraw
# RATE_LIMIT_TELEMETRY=60  # per-user /min for POST /telemetry (client batches ~12/min)
# RATE_LIMIT_SEARCH=30  # per-user /min for GET /search (regex fan-out; caps DoS amplification)

# --- Orchestrator agent loop bound ---
# MAX_ITERATIONS=10

# --- Personal-data residency (152-FZ transborder guard) ---
# When false (DEFAULT) the orchestrator redacts personal data (phones, emails,
# IBAN/INN/passport/card numbers) from outbound LLM requests — history, tool
# results, and the per-business prompt block — before they reach a provider that
# may run outside Russia. Set true ONLY with a legal basis for transborder
# personal-data transfer, or when inference is routed exclusively to RU /
# self-hosted endpoints (SELF_HOSTED_N_*). See docs/orchestrator/config.md.
# ALLOW_TRANSBORDER_LLM=false

# --- Cost guards (see docs/llm-cost-guards.md for the operator runbook) ---
# Per-business daily LLM spend cap (USD). 0 = use the compiled default for
# the tier; -1 = unlimited; positive = override.
# LLM_FREE_TIER_DAILY_SPEND_USD=

# Per-conversation token caps. 0 disables that axis. Tool-result tokens count
# toward the input cap because the next iteration sends them back as input.
# LLM_CONVERSATION_INPUT_CAP=50000
# LLM_CONVERSATION_OUTPUT_CAP=10000

# Rate-limiter behavior when Redis is unreachable.
#   block          — fail closed; chat turns return a rate_limit_unavailable
#                    SSE error until Redis recovers (DEFAULT).
#   local_fallback — consult an in-process token bucket (per-pod, NOT per-
#                    business) so a short Redis outage degrades gracefully.
# LLM_RATELIMIT_ON_REDIS_DOWN=block

# Local bucket rate when policy=local_fallback. Required when policy is
# local_fallback. ~2000 req/h ≈ a $10/h ceiling at $0.005 avg per request.
# LLM_LOCAL_FALLBACK_REQUESTS_PER_HOUR=2000

# How long the limiter consults the local bucket before re-attempting Redis.
# LLM_LOCAL_FALLBACK_WINDOW=30s

# --- Per-user SSE concurrency cap ---
# Maximum concurrent SSE streams (chat turns) per user. The cap shares the
# Redis-down policy (LLM_RATELIMIT_ON_REDIS_DOWN) and local fallback knob
# (LLM_LOCAL_FALLBACK_REQUESTS_PER_HOUR) above. Set to 0 to disable the gate
# entirely. Default 3 fits free-beta single-pod scale; raise for paid tiers
# or larger deployments. Fail-loud on non-integer / negative input.
# SSE_MAX_PER_USER=3

# --- Chat-history fetch limit ---
# Number of prior messages loaded into the LLM context per chat turn (also read
# by the auto-titler). Default 100. Must be > 0 and <= 500; the upper bound
# caps prompt size / per-turn cost. Fail-loud on non-integer / out-of-range input.
# MESSAGE_HISTORY_LIMIT=100

# Redis connection used by the orchestrator's rate limiter and the platform
# agents' HITL dedupe. Leave unset to disable (dev runs without a Redis
# sidecar). Production sets this so all cost guards are active. When Redis
# runs with requirepass, embed the password in the URL:
#   REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
# REDIS_URL=redis://redis:6379

# --- Cookie security. Unset = derived from the PUBLIC_URL scheme (https ⇒
# true, plain http ⇒ false). Browsers discard the Secure `__Host-` refresh
# cookie on an http origin, so forcing true on a plain-HTTP stand signs the
# user out on every full page load. Set explicitly only to override; a
# non-boolean value aborts boot. ---
# SECURE_COOKIES=true

# --- VK API version override ---
# VK_API_VERSION=5.199

# --- Service-internal ports (rarely changed) ---
# PORT=8080
# INTERNAL_PORT=8443
# HEALTH_PORT=8081   # per-agent; differs in compose for each agent service

# --- mTLS (cluster-internal trust boundary on :8443) ---
# The API's internal :8443 listener requires a client cert signed by the
# dev CA. Orchestrator + all 4 platform agents talk to it via mTLS.
#
# Dev workflow (one-time per checkout):
#   make mtls-certs   # generates infra/mtls/certs/{ca,api,orchestrator,agent-*}.crt+key
#
# All five env vars below are set per-service in docker-compose.yml; the
# entries here are for reference + for operators running services
# outside compose (e.g. `go run ./services/api/cmd/main.go`).
ONEVOICE_MTLS_ENABLED=true
ONEVOICE_MTLS_CA_PATH=/etc/onevoice/mtls/ca.crt
# Per-service leaf cert + key. Replace `api` with `orchestrator`,
# `agent-telegram`, etc. when running a different binary locally.
ONEVOICE_MTLS_CERT_PATH=/etc/onevoice/mtls/api.crt
ONEVOICE_MTLS_KEY_PATH=/etc/onevoice/mtls/api.key

# --- Internal per-platform ACL (/internal/v1/tokens) ---
# Declarative client-cert CN → allowed platforms map gating the internal token
# endpoint. The mTLS handshake establishes WHO the caller is; this map decides
# WHAT platform that CN may request, closing the cross-tenant gap where any
# authed agent could fetch another platform's secrets. Required at boot — a
# missing or malformed value makes the API fail fast.
# Format: JSON map of CN → []platforms. "*" wildcard permitted (orchestrator/api).
ONEVOICE_INTERNAL_ACL_JSON={"agent-telegram":["telegram"],"agent-vk":["vk"],"agent-yandex-business":["yandex_business"],"agent-google-business":["google_business"],"orchestrator":["telegram","vk","yandex_business","google_business"],"api":["*"]}

# --- Logging ---
# LOG_LEVEL=info     # debug | info | warn | error


# ---------------------------------------------------------------------
# 12. Transactional email (Account Lifecycle)
# ---------------------------------------------------------------------
# Required for password reset, email verification, and account-delete
# warning emails. When UNISENDER_API_KEY is empty the API falls back
# to an in-memory NoopSender (local dev only). Production MUST set the
# API key — see docs/runbook-email-dns.md for the operator handoff
# (DKIM/SPF/DMARC records must be live BEFORE the first send or RU
# mailbox providers route to spam).

# Unisender Go API key. Generate in the Unisender Go web console:
# Settings -> API keys -> Create. RU jurisdiction; HTTPS-JSON; no SDK.
UNISENDER_API_KEY=

# From-address for every transactional email. Must be a
# verified domain in your Unisender Go account (Settings -> Domains).
UNISENDER_FROM_EMAIL=noreply@onevoice.app

# Display name shown in the recipient's inbox.
UNISENDER_FROM_NAME=OneVoice

# Address that receives a notification when a user submits in-app feedback
# (POST /feedback). Empty disables the notification — feedback is still
# persisted to product_feedback and queryable.
FEEDBACK_NOTIFY_EMAIL=

# Outbox worker poll interval. Lower = lower email latency, higher PG
# load. 5s is the sweet spot for v1.4 beta volume (~10k emails/month).
OUTBOX_POLL_INTERVAL=5s

# Max delivery attempts per outbox row before status transitions to
# 'failed'. Backoff is exponential: 1m, 2m, 4m, 8m, 16m.
OUTBOX_MAX_ATTEMPTS=5


# ---------------------------------------------------------------------
# 13. Legal entity (152-ФЗ Art. 14 data controller)
# ---------------------------------------------------------------------
# OneVoice processes Russian PD; 152-ФЗ Art. 14 requires the data
# controller (legal entity name, ИНН, address, contact email for ПДн
# requests) to be visible in the Privacy Policy + /legal/contact + the
# site footer. These values MUST be set to real, non-placeholder content
# before production deploy. The launch-readiness runbook verifies this.
# Without them, /legal/* renders the «[Юридическое лицо — будет
# обновлено]» fallback and the footer emits console.warn.
#
# The duplicated NEXT_PUBLIC_LEGAL_* values are read by the frontend
# (Next.js requires NEXT_PUBLIC_ prefix for browser-visible env vars).
# Keep the two sets in sync — the launch-readiness runbook greps both.

# Legal entity full name — e.g. "ООО ВанВойс" or "ИП Михайлов Даниил".
# Min >=4 Cyrillic characters; placeholder / empty rejected when
# APP_ENV=production.
LEGAL_ENTITY_NAME=
# Tax ID (ИНН) — 10 digits for ООО, 12 digits for ИП. Verified against
# the FNS control-digit checksum when APP_ENV=production.
LEGAL_INN=
# Full registered legal address (юридический адрес). Min 20 characters
# when APP_ENV=production.
LEGAL_ADDRESS=
# Email address that ПДн subject-rights requests should be sent to.
# Often pdn@<your-domain>. Parsed as RFC 5322 when APP_ENV=production.
LEGAL_EMAIL_PDN=

# Frontend mirrors — required so /legal/contact + footer render the
# correct values without a roundtrip to the API. Because Next.js inlines
# NEXT_PUBLIC_* at build time, these must be passed as docker build args to
# the frontend image (they are NOT read at container runtime):
#   docker build --build-arg APP_ENV=production \
#     --build-arg NEXT_PUBLIC_LEGAL_ENTITY_NAME="ООО ВанВойс" \
#     --build-arg NEXT_PUBLIC_LEGAL_INN="…" … services/frontend
NEXT_PUBLIC_LEGAL_ENTITY_NAME=
NEXT_PUBLIC_LEGAL_INN=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_LEGAL_EMAIL_PDN=

# ─── LEGAL ENTITY LAUNCH GATE ─────────────────────────────────────────
# The 8 LEGAL_* / NEXT_PUBLIC_LEGAL_* vars above MUST be set to real,
# non-placeholder values before deploy. Two HARD gates enforce this when
# APP_ENV=production (both reject empty / placeholder / checksum-invalid
# values, so a placeholder identity can never reach production):
#   - API boot: services/api/internal/config validateLegalProduction
#     aborts startup if any LEGAL_* field is bad.
#   - Frontend build: services/frontend/scripts/check-legal-entity.mjs
#     (run by `pnpm build`) fails `next build` if any NEXT_PUBLIC_LEGAL_*
#     is bad — pass APP_ENV=production + the values as docker build args.
# With APP_ENV unset (local / CI), both gates skip so dev needs no real
# legal data; /legal/* then renders the «[Юридическое лицо — будет
# обновлено]» fallback and the footer emits console.warn.
#
# After setting them, walk through `docs/runbook-launch-readiness.md §6
# (Legal compliance)` before deploying. §6 is a HARD block.
# ───────────────────────────────────────────────────────────────────────
# ---------------------------------------------------------------------
# 14. Operational hardening (health, observability, lockout)
# ---------------------------------------------------------------------
# Per-dep timeout for /health/ready. Checks run CONCURRENTLY (sync.WaitGroup
# in pkg/health.ReadyHandler), so total wall-clock budget = HEALTH_CHECK_TIMEOUT
# (max, not Σ deps × timeout). Default 2s gives ~20× headroom over healthy
# responses (<100ms typical) while staying inside the k8s readinessProbe 5s
# default. Zero / negative / unparseable values fall back to 2s.
# HEALTH_CHECK_TIMEOUT=2s

# ---------------------------------------------------------------------
# Grafana admin password — LAUNCH GATE
# ---------------------------------------------------------------------
# MANDATORY. docker-compose.observability.yml refuses to start without
# this set (uses ${VAR:?...} interpolation). Launch-readiness runbook
# rejects the deploy if value is `admin`, empty, or shorter than 16
# chars.
#
# Generate:  openssl rand -base64 24
GF_SECURITY_ADMIN_PASSWORD=
# Optional: override the admin username (default `admin`).
# GF_SECURITY_ADMIN_USER=admin


# ---------------------------------------------------------------------
# 15. Backup
# ---------------------------------------------------------------------
# The backup container (docker-compose.observability.yml) runs daily at
# 00:00 UTC (= 03:00 MSK) via BusyBox crond. It pg_dump + mongodumps
# OneVoice DBs and pushes the archives via restic to Yandex Object
# Storage. RESTIC_PASSWORD is KMS-encrypted at rest; entrypoint.sh
# decrypts via the Yandex Cloud service-account credentials below.

# Backup container connects to PG + Mongo on the internal network. Use a
# least-privilege user (e.g. `backup_user` with pg_read_all_data role on
# Postgres, read role on Mongo). NOT the application's connection user.
BACKUP_PG_DSN=postgres://backup_user:replace_me@postgres:5432/onevoice?sslmode=disable
BACKUP_MONGO_URI=mongodb://backup_user:replace_me@mongodb:27017/onevoice?authSource=admin

# Yandex Object Storage bucket. Create with 30-day lifecycle on prefix
# `daily/`. See docs/runbook-restore.md §1.
YC_BACKUP_BUCKET=onevoice-backups
RESTIC_REPOSITORY=s3:https://storage.yandexcloud.net/onevoice-backups
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ru-central1

# ---------------------------------------------------------------------
# KMS-managed restic password (152-ФЗ Art. 19 §2(2))
# ---------------------------------------------------------------------
# NEVER store RESTIC_PASSWORD in plaintext on the host. The container
# decrypts via Yandex KMS at boot.
#
# One-time setup:
#   yc kms symmetric-key create --name onevoice-restic --default-algorithm aes-256
#   RESTIC_PW=$(openssl rand -base64 32)
#   echo -n "$RESTIC_PW" | yc kms symmetric-crypto encrypt \
#       --id <key-id> --plaintext-file - --ciphertext-file - | base64
#   # Paste the base64 output below as RESTIC_PASSWORD_CIPHERTEXT.
#   # SAVE $RESTIC_PW IN YOUR PASSWORD MANAGER — needed if KMS is unreachable
#   # during disaster recovery (see runbook §5).
RESTIC_PASSWORD_KMS_KEY_ID=
RESTIC_PASSWORD_CIPHERTEXT=

# Service-account JSON for the KMS-decrypt call. Generate via:
#   yc iam service-account create --name onevoice-backup
#   yc resource-manager folder add-access-binding <folder> \
#       --role kms.keys.encrypterDecrypter \
#       --service-account-name onevoice-backup
#   yc iam key create --service-account-name onevoice-backup --output sa.json
# Then paste the file contents below as a single-line JSON value.
# Also consumed by services/api for token envelope encryption (KMS calls).
YC_SA_JSON_CREDENTIALS=

# --- Token envelope encryption (Phase 30) ---
# Yandex Cloud KMS symmetric key whose versions wrap each integration row's
# data-encryption key. REQUIRED by services/api — the api fails to boot
# without it. Reuses YC_SA_JSON_CREDENTIALS above for the KMS API calls.
#   yc kms symmetric-key create --name onevoice-token-enc
#   yc kms symmetric-key get --name onevoice-token-enc --format json | jq -r .id
TOKEN_ENCRYPTION_KMS_KEY_ID=
# Optional: comma-separated KMS key versions to also try on decrypt during a
# rotation window (max 5). Leave empty unless mid-rotation.
TOKEN_ENCRYPTION_KMS_DUAL_DECRYPT_VERSIONS=
# Optional: versionID=int16 entries (comma-separated) pinning KMS version IDs
# to the int16 key_version stored per row. Leave empty for single-version setups.
TOKEN_ENCRYPTION_KMS_VERSION_MAP=

# Prometheus pushgateway URL — backup.sh pushes success/failure
# timestamps and run duration. Internal docker DNS; the pushgateway
# service is on onevoice-network with no host port (tailnet-only stack).
PUSHGATEWAY_URL=http://pushgateway:9091

# ---------------------------------------------------------------------
# Operator alerting (Alertmanager → @onevoice_alerts_bot Telegram bot)
# ---------------------------------------------------------------------
# DEDICATED ops bot — DO NOT reuse TELEGRAM_BOT_TOKEN (that one talks to
# customer channels via agent-telegram). Create a second bot via
# @BotFather, then send /start from your personal Telegram and read your
# chat_id from https://api.telegram.org/bot<TOKEN>/getUpdates.
#
# The token and chat_id are written by the alertmanager container's
# entrypoint into /etc/alertmanager/secrets/{bot_token,chat_id} files
# (mode 0600). Rotation: edit .env, `docker compose up -d alertmanager`.
#
# Full bootstrap procedure: docs/runbook/observability.md.
AM_TELEGRAM_BOT_TOKEN=
AM_TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------
# Lockout + Yandex SmartCaptcha
# ---------------------------------------------------------------------
# Layered defense on /auth/login:
#   0-3 failures  → normal login (no friction)
#   4-9 failures  → SmartCaptcha challenge (invisible widget)
#   10+ failures  → lock (email_hash, /16 IP) for LOCKOUT_DURATION
#
# Key format: onevoice:lockout:sha256(lowercase(email)):x.y.0.0/16
# Email is hashed so a Redis dump cannot enumerate the email allowlist.
# /16 IP bucketing absorbs shared-NAT collisions while preventing /32
# evasion.
LOCKOUT_FAIL_THRESHOLD_CAPTCHA=4
LOCKOUT_FAIL_THRESHOLD_LOCK=10
LOCKOUT_DURATION=15m

# Trusted-proxy CIDRs (comma-separated). When req.RemoteAddr is NOT in
# this set, X-Forwarded-For is IGNORED and req.RemoteAddr is used as the
# client IP. Defaults to Yandex Cloud LB published ranges (refresh with
# `yc managed-network-load-balancer list-ip-addresses` if Yandex changes them).
TRUSTED_PROXY_CIDRS=178.154.250.0/24,84.252.160.0/19

# Yandex SmartCaptcha (invisible mode). Provision via
# https://console.yandex.cloud/folders/<folder>/smartcaptcha — 250k/month
# free tier covers v1.4 traffic. Cloudflare Turnstile was rejected
# because RKN throttles CF intermittently.
SMARTCAPTCHA_SITE_KEY=
SMARTCAPTCHA_SECRET_KEY=
# Frontend-exposed copy of the site key (Next.js public env).
NEXT_PUBLIC_SMARTCAPTCHA_SITE_KEY=
# Fail-open on Yandex outage — bot-through during an outage is
# acceptable; locking every real user out is not. Set to "false" to
# reject logins (return 403 captcha_invalid) on ErrCaptchaTransient.
SMARTCAPTCHA_FAIL_OPEN=true
