# Server Configuration
PORT=8080

# CORS — comma-separated list of frontend origins allowed to hit the API.
# Production deploys MUST set this to the public frontend origin
# (e.g. https://app.example.com). When unset, only http://localhost:3000
# is allowed (dev default).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=onevoice

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=onevoice

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secret (minimum 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars

# AES Encryption Key (exactly 32 bytes)
ENCRYPTION_KEY=12345678901234567890123456789012

# Frontend API URL — base URL the Next.js frontend uses for all API calls.
# Inlined at build time by Next.js (NEXT_PUBLIC_* prefix). Default "/api/v1"
# uses the same-origin rewrite proxy in next.config.js. Set to a full URL
# (e.g. https://api.example.com/api/v1) only if the frontend is served from
# a different origin and CORS_ALLOWED_ORIGINS includes the frontend origin.
NEXT_PUBLIC_API_URL=/api/v1

# VK API version — value of the &v= query param on every VK REST call.
# When unset, vkapi.DefaultAPIVersion (5.199) is used. Set this if VK
# announces a new version and you want to roll forward without redeploy.
# VK_API_VERSION=5.199

# HTTP server / orchestrator timeouts (Go duration syntax: 10s, 1m, 1h30m).
# All optional — defaults match the previously-hardcoded values.
# HTTP_READ_TIMEOUT          ReadTimeout for the public API server (default 15s)
# HTTP_READ_HEADER_TIMEOUT   ReadHeaderTimeout for the internal mTLS server (default 10s)
# HTTP_IDLE_TIMEOUT          IdleTimeout for keepalive sockets (default 60s)
# ORCHESTRATOR_FETCH_TIMEOUT Per-request budget against the orchestrator (default 10s)
# HTTP_READ_TIMEOUT=15s
# HTTP_READ_HEADER_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
# ORCHESTRATOR_FETCH_TIMEOUT=10s

# Per-endpoint per-minute request budgets enforced by the chi rate limiter.
# Defaults match the values previously hardcoded in router.Setup. Tighter
# than login on register because automated signup abuse is the primary risk
# of getting these wrong.
# RATE_LIMIT_REGISTER=5
# RATE_LIMIT_LOGIN=10
# RATE_LIMIT_CHAT=10
# RATE_LIMIT_HITL=10
