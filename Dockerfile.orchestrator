# syntax=docker/dockerfile:1.6

# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

ENV GOWORK=off
ENV GOTOOLCHAIN=auto

COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/orchestrator/go.mod services/orchestrator/go.sum ./services/orchestrator/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd pkg && for i in 1 2 3; do go mod download && break || sleep 5; done

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd services/orchestrator && for i in 1 2 3; do go mod download && break || sleep 5; done

COPY pkg/ ./pkg/
COPY services/orchestrator/ ./services/orchestrator/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd services/orchestrator && CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/bin/orchestrator ./cmd/main.go

# Runtime stage
FROM alpine@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11

RUN apk --no-cache add ca-certificates tzdata

RUN addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app

WORKDIR /app

COPY --from=builder /app/bin/orchestrator .
COPY scripts/entrypoint-ulimit.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 8090

USER 10001:10001

ENTRYPOINT ["/entrypoint.sh"]
CMD ["./orchestrator"]
