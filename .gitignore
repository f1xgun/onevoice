# Worktrees
.worktrees/

# Binaries
bin/
tools/lint-rbac/lint-rbac
tools/nourl/nourl
tools/oapi-validate-tags/oapi-validate-tags

# OpenAPI build artifacts (preprocessed spec, regenerated each codegen run)
docs/api/spec/.openapi.validate.yaml
*.exe
*.dll
*.so
*.dylib

# Go
vendor/

# Node
services/frontend/node_modules/
services/frontend/.next/

# Environment
.env
.env.local
.env.*.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker volumes
postgres_data/
mongo_data/
redis_data/
nats_data/
minio_data/

# Certificates
certs/
# But preserve the gitignore stub inside infra/mtls/certs so the dev cert
# directory exists as a tracked path (cert contents stay gitignored via
# infra/mtls/certs/.gitignore).
!infra/mtls/certs/
infra/mtls/certs/*
!infra/mtls/certs/.gitignore

# Temporary
tmp/
*.log

# LaTeX artifacts
*.aux
*.out
*.toc
*.synctex.gz

# Test coverage
*.coverage
coverage_integration.out

# GSD planning artifacts
.planning/

# RPA debug screenshots
rpa-screenshots/

# Playwright artifacts
.playwright-mcp/

# Claude worktrees
.claude/worktrees/
