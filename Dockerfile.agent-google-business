# syntax=docker/dockerfile:1.6

# Build stage
FROM golang:1.25-alpine AS builder

WORKDIR /app

RUN apk add --no-cache git

ENV GOWORK=off
ENV GOTOOLCHAIN=auto

COPY pkg/go.mod pkg/go.sum ./pkg/
COPY services/agent-google-business/go.mod services/agent-google-business/go.sum ./services/agent-google-business/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd pkg && for i in 1 2 3; do go mod download && break || sleep 5; done

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd services/agent-google-business && for i in 1 2 3; do go mod download && break || sleep 5; done

COPY pkg/ ./pkg/
COPY services/agent-google-business/ ./services/agent-google-business/

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd services/agent-google-business && CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o /app/bin/agent ./cmd/main.go

# Runtime stage
FROM alpine@sha256:5b10f432ef3da1b8d4c7eb6c487f2f5a8f096bc91145e68878dd4a5019afde11

RUN apk --no-cache add ca-certificates tzdata

RUN addgroup -S -g 10001 app && adduser -S -D -H -u 10001 -G app app

WORKDIR /app

COPY --from=builder /app/bin/agent .
COPY scripts/entrypoint-ulimit.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER 10001:10001

ENTRYPOINT ["/entrypoint.sh"]
CMD ["./agent"]
